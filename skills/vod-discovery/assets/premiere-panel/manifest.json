{
  "manifestVersion": 5,
  "id": "local.vod-discovery.markers",
  "name": "VOD suggestions",
  "version": "0.1.0",
  "main": "index.html",
  "host": {"app": "premierepro", "minVersion": "25.6.0"},
  "requiredPermissions": {"localFileSystem": "request"},
  "entrypoints": [{
    "type": "panel", "id": "vod-suggestions", "label": {"default": "VOD suggestions"},
    "minimumSize": {"width": 320, "height": 280},
    "preferredDockedSize": {"width": 360, "height": 450},
    "preferredFloatingSize": {"width": 420, "height": 480}
  }]
}
